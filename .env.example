# Copy to .env on the target host and fill in. NEVER commit .env.
SERVER_NAME=Valheim src21
WORLD_NAME=vreipenorduluiboss
# Steam requires >= 5 characters, and it must NOT contain the server name.
SERVER_PASS=CHANGE_ME_min5chars
SERVER_PUBLIC=true

# Ports. Valheim is UDP-only, so there is no overlap with anything else.
VALHEIM_PORT=2456
VALHEIM_QUERY_PORT=2457

# Resource ceiling. Sized for a DEDICATED 8GB box: leaves ~2GB + 1 core to
# the OS. Lower these if the instance is smaller — preflight.sh verifies.
VALHEIM_MEM_LIMIT=6g
VALHEIM_CPUS=3.0

# -crossplay enables Xbox/Game Pass players; drop it for Steam-only.
SERVER_ARGS=-crossplay
TZ=Europe/Bucharest
